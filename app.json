{
  "expo": {
    "name": "Granny Memories",
    "slug": "granny-memories",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6EFEC",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.paulaksm.grannymemories"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      "llama.rn",
      [
        "expo-audio",
        {
          "microphonePermission": "O Granny Memories usa o microfone para gravar as suas histórias."
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "1a101ff8-8296-4094-8325-656d80de9973"
      }
    },
    "owner": "pksm"
  }
}
